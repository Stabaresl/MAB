# Proyecto de Supabase — Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. SECRETA: se salta las politicas RLS.
# Solo la usan los scripts de mantenimiento (scripts/seed.mjs).
# Nunca debe llevar el prefijo NEXT_PUBLIC_ ni subirse al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# URL publica del sitio, para enlaces absolutos y metadatos.
# En Vercel se deduce sola; en local dejala como esta.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
