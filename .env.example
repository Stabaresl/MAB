# Proyecto de Supabase — Project Settings › API
#
# Sin prefijo NEXT_PUBLIC_ a proposito: el sitio no habla con Supabase desde el
# navegador en ningun punto —catalogo por componentes de servidor, sesion por
# el middleware, escrituras por Server Actions—, asi que estos valores no
# tienen por que viajar al visitante. Ver el comentario de lib/env.ts.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Clave de servicio. SECRETA: se salta las politicas RLS.
# Solo la usan los scripts de mantenimiento (scripts/seed.mjs).
# Nunca debe llevar el prefijo NEXT_PUBLIC_ ni subirse al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# URL publica del sitio, para enlaces absolutos y metadatos.
# En Vercel se deduce sola; en local dejala como esta.
SITE_URL=http://localhost:3000
